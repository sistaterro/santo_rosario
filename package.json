{
  "name": "santo-rosario",
  "version": "0.1.0",
  "private": true,
  "description": "Simple Santo Rosario app built with Capacitor.",
  "scripts": {
    "sync": "cap sync android",
    "copy": "cap copy android",
    "assets": "npx @capacitor/assets generate --android",
    "apk:download": "copy /Y android\\app\\build\\outputs\\apk\\debug\\app-debug.apk app-download\\santo_rosario.apk",
    "clean": "cd android && gradlew.bat clean && cd ..",
    "open:android": "cap open android",
    "run:android": "npm run sync && npm run assets && npx cap run android",
    "build:android": "build-android.bat",
    "release:android": "npm run sync && npm run assets && cd android && gradlew.bat assembleRelease"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "^7.1.0",
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/splash-screen": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2"
  }
}
